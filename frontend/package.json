{
  "name": "cafeteria-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Módulo Cliente (smartphone, via QR Code) e Módulo Colaborador (desktop) do sistema da cafeteria",
  "type": "module",
  "scripts": {
    "dev:cliente": "vite --config vite.cliente.config.ts",
    "dev:painel": "vite --config vite.painel.config.ts",
    "build:cliente": "vite build --config vite.cliente.config.ts",
    "build:painel": "vite build --config vite.painel.config.ts",
    "build": "npm run build:cliente && npm run build:painel",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mock": "node dev/mock-api.mjs",
    "imagens": "node scripts/gerar-imagens.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
