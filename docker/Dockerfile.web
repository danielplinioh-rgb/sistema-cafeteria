# Compila os dois front-ends e serve com nginx. Contexto de build: raiz do projeto.
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend/ .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist/cliente /site/cliente
COPY --from=build /app/dist/painel /site/painel
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
