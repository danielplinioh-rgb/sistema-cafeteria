# Copie para ".env" e troque os valores. NUNCA versione o arquivo .env.
DB_ADMIN_SENHA=troque-esta-senha-admin
DB_APP_SENHA=troque-esta-senha-da-aplicacao
# true carrega produtos de exemplo e o usuário de teste ana.souza (senha pública!). Use false em produção.
CARREGAR_DADOS_DEMO=true
# true somente com HTTPS
COOKIE_SEGURO=false
PORTA_WEB=80
